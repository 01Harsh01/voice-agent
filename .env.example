# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM Gateway Configuration
# Options: huggingface (or any OpenAI-compatible provider)
LLM_PROVIDER=huggingface
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=your_huggingface_token_here
LLM_API_KEY=

# Rime TTS WebSocket Configuration
RIME_API_KEY=your_rime_api_key_here
RIME_WS_ENDPOINT=wss://users-ws.rime.ai/ws3
RIME_MODEL_ID=coda
RIME_SPEAKER=astra
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLING_RATE=24000

# Web Search Provider Configuration
# duckduckgo requires no API key (zero-config real live web results)
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# Agent & Request Timeouts & Limits
MAX_TOOL_ITERATIONS=5
REQUEST_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=20
WEB_TIMEOUT_SECONDS=10
RIME_TIMEOUT_SECONDS=15
